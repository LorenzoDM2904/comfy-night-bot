# Copy this file to .env and fill in at least the first two lines.

# --- Telegram ---------------------------------------------------------------------
# The bot token (from @BotFather) and the Telegram ids allowed to use it,
# comma separated (@userinfobot, for example, tells you your id).
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=123456789

# --- ComfyUI ----------------------------------------------------------------------
# The ComfyUI address (ComfyUI Desktop often uses port 8000).
COMFYUI_BASE_URL=http://127.0.0.1:8188
EXECUTION_BACKEND=local

# Optional: the bot starts ComfyUI when there is a job and stops it when
# it is done. false = ComfyUI stays on by itself.
COMFYUI_MANAGE=false
# With COMFYUI_MANAGE=true: the ComfyUI folder (the one with main.py)...
COMFYUI_INSTALL_DIR=
# ...or a full command to start it.
# COMFYUI_START_CMD=
# Optional: a folder with ComfyUI's input/ and output/ and the
# extra_model_paths.yaml file (for example ComfyUI Desktop's).
COMFYUI_SHARED=
COMFYUI_EXTRA_MODEL_PATHS_CONFIG=
COMFYUI_PIDFILE=/tmp/comfyui_nightbot.pid
COMFYUI_LOG=/tmp/comfyui_nightbot.log
COMFYUI_BOOT_TIMEOUT=360

# --- Night ------------------------------------------------------------------------
APP_TIMEZONE=Europe/Rome
NIGHT_MODE_DEFAULT=true
NIGHT_START=00:30
NIGHT_FINISH=08:00

# --- Folders ----------------------------------------------------------------------
DATA_DIR=./data
# Your components (see COMPONENTS.md).
COMPONENTS_DIR=./components
# Plugin folders, separated by ":" (see plugins/README.md).
PLUGINS_DIRS=./plugins
# /list without a component: the first compatible one of these (ids,
# comma separated). With a single compatible component, that one is used.
AUTO_COMPONENTS=

# --- Jobs -------------------------------------------------------------------------
# The timeout does not interrupt a remote job: past it, the job becomes
# «uncertain outcome» and the bot moves on to the next one.
JOB_TIMEOUT_MINUTES=240
POLL_SECONDS=10
# Periodic health and progress check (minutes).
WATCHDOG_MINUTES=20
MAX_INPUT_MB=18
VIDEO_MAX_MB=20
# /upscale: the WxH box the image is fitted into (proportions kept).
UPSCALE=1080x1350

# --- Describing images (optional) -------------------------------------------------
# A llama.cpp server with a vision model (OpenAI-compatible endpoint).
LLAMA_BASE_URL=http://127.0.0.1:9931
DESCRIBE_MODEL=unsloth/Qwen3.5-4B-MTP-GGUF:Q4_K_XL
# System prompts instead of the default ones: the text, or the @path of
# a file holding the text.
# ANALYZE_SYSTEM_PROMPT=@prompts/analyze.txt
# DESCRIBE_SYSTEM_PROMPT=@prompts/describe.txt
# DESCRIBEIMG_SYSTEM_PROMPT=@prompts/describeimg.txt
